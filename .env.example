# Copy to .env and fill in. Used by docker compose.

# Secret that becomes the MCP URL path: the endpoint is /<MCP_TOKEN>
# (e.g. https://metamcp.example.com/<MCP_TOKEN>). Generate a long random value:
#   openssl rand -hex 32        (or: python -c "import secrets; print(secrets.token_urlsafe(32))")
MCP_TOKEN=replace-with-a-long-random-token

# Public HTTPS base URL of the server (your subdomain, NO trailing slash, NO token).
# Used in the OAuth metadata so claude.ai's web connector can register/connect.
MCP_PUBLIC_URL=https://metamcp.example.com

# Only needed for the OPTIONAL Caddy stack (docker-compose.caddy.yml): the domain
# (A record pointed at this VPS) Caddy gets HTTPS for.
MCP_DOMAIN=metamcp.example.com
