# Copy to .env and fill in. Used by docker compose.

# Secret embedded in the MCP URL path: the endpoint becomes /mcp/<MCP_TOKEN>.
# Generate a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=replace-with-a-long-random-token

# Only needed for the OPTIONAL Caddy stack (docker-compose.caddy.yml).
# The public domain (A record pointed at this VPS) Caddy gets HTTPS for.
MCP_DOMAIN=mcp.example.com
