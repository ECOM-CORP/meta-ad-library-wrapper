# Copy to .env and fill in. Used by docker compose.

# Secret that becomes the MCP URL path: the endpoint is /<MCP_TOKEN>
# (e.g. https://metamcp.example.com/<MCP_TOKEN>). Generate a long random value:
#   openssl rand -hex 32        (or: python -c "import secrets; print(secrets.token_urlsafe(32))")
MCP_TOKEN=replace-with-a-long-random-token

# Auth mode. Leave 0 (authless) — it works once Cloudflare/WAF isn't blocking Anthropic's
# server-to-server request. Set MCP_OAUTH=1 only if claude.ai's web connector still won't
# connect authless; that turns on a no-users, auto-approve OAuth layer.
MCP_OAUTH=0

# Your public subdomain (A record pointed at this VPS). Required when MCP_OAUTH=1 (used to
# build the OAuth metadata URL https://<MCP_DOMAIN>) and for the optional Caddy stack.
MCP_DOMAIN=metamcp.example.com

# Optional: only set this to override the public base URL (otherwise it's
# https://<MCP_DOMAIN>). No trailing slash, no token.
# MCP_PUBLIC_URL=https://metamcp.example.com

# Optional: log verbosity in `docker compose logs` (DEBUG | INFO | WARNING). Default INFO
# logs each tool call + any Meta errors/retries (incl. rate limits).
# MCP_LOG_LEVEL=INFO

# Rate-limit avoidance. Each GraphQL request waits a random delay in this range (seconds)
# to look human; lower MCP_REACH_WORKERS = fewer parallel reach lookups. Reach is cached on
# disk for MCP_REACH_CACHE_TTL_DAYS so repeat ads aren't re-fetched. Raise the delays /
# lower the workers if you still hit code 1675004 (Rate limit exceeded).
# MCP_REQUEST_DELAY_MIN=2.0
# MCP_REQUEST_DELAY_MAX=3.0
# MCP_REACH_WORKERS=2
# MCP_REACH_CACHE_TTL_DAYS=3
